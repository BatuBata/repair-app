; Dedicated pool; place under /etc/php/<VERIFIED_VERSION>/fpm/pool.d/repair-app.conf
[repair-app]
user = www-data
group = www-data
listen = /run/php/repair-app.sock
listen.owner = www-data
listen.group = www-data
listen.mode = 0660
pm = ondemand
pm.max_children = 5
pm.process_idle_timeout = 10s
pm.max_requests = 500
clear_env = yes
security.limit_extensions = .php
php_admin_flag[display_errors] = off
php_admin_flag[log_errors] = on
php_admin_value[error_log] = /var/log/php/repair-app-error.log
